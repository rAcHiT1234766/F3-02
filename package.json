{
  "name": "foundation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "tokens:build": "npm run build -w @foundation-local/tokens",
    "tokens:figma-export": "node packages/tokens/figma-export.mjs",
    "tokens:import": "node packages/tokens/figma-import.mjs",
    "dev": "npm run tokens:build && npm run dev -w @rachitp72/foundation-ui",
    "dev:demo": "npm run build && npm run dev -w @foundation-local/demo",
    "preview:foundation": "node scripts/preview-tokens.mjs && npm run build -w @rachitp72/foundation-ui && npm run build -w @foundation-local/demo && npm run preview -w @foundation-local/demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build && tsc -p packages/ui/tsconfig.json && tsc -p apps/demo/tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:tokens": "node --test packages/tokens/test/*.test.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:storybook": "node scripts/storybook-check.mjs",
    "build": "npm run tokens:build && npm run build -w @rachitp72/foundation-ui",
    "build:storybook": "npm run tokens:build && npm run build:storybook -w @rachitp72/foundation-ui",
    "build:demo": "npm run build && npm run build -w @foundation-local/demo",
    "check": "npm run lint && npm run typecheck && npm run test:tokens && npm run test:contrast && npm test && npm run build:demo",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "chromatic": "node scripts/chromatic.mjs",
    "perf": "npm run build && node scripts/perf-check.mjs",
    "perf:lighthouse": "npm run build:demo && node scripts/lighthouse-check.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.18",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.14.0",
    "babel-jest": "30.5.2",
    "chromatic": "^13.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.5.3",
    "puppeteer-core": "25.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "6.4.5"
  }
}
